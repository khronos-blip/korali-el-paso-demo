{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "korali-el-paso-demo",
  "main": "worker.js",
  "compatibility_date": "2026-09-23",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "none"
  },
  "routes": [
    {
      "pattern": "koralidigital.com/demos/el-paso/*",
      "zone_name": "koralidigital.com"
    },
    {
      "pattern": "www.koralidigital.com/demos/el-paso/*",
      "zone_name": "koralidigital.com"
    }
  ]
}
